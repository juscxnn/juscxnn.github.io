---
import "../styles/global.css";

export interface Props {
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>;
  ogImage?: string;
}

const { title, description, jsonLd } = Astro.props;
const ogImage = Astro.props.ogImage ?? new URL("/og.png", Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — Justin Chua</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={Astro.url} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#F5F1E9" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#17161A" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    {
      jsonLd && (
        <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
      )
    }
    <script>
      (function () {
        var t = localStorage.getItem("theme");
        if (!t) t = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        document.documentElement.setAttribute("data-theme", t);
        document.addEventListener("DOMContentLoaded", function () {
          var b = document.querySelector(".theme-btn");
          if (b) b.textContent = t === "dark" ? "light" : "dark";
        });
        window.toggleTheme = function () {
          var c = document.documentElement.getAttribute("data-theme");
          var n = c === "dark" ? "light" : "dark";
          document.documentElement.setAttribute("data-theme", n);
          localStorage.setItem("theme", n);
          var b = document.querySelector(".theme-btn");
          if (b) b.textContent = n === "dark" ? "light" : "dark";
        };
      })();
    </script>
    
  </head>
  <body>
    <header class="nav">
      <div class="wrap nav-inner">
        <a class="wordmark" href="/">Justin Chua</a>
        <div class="nav-right">
          <a class="nav-btn" href="/studies">writings</a>
          <button class="nav-btn theme-btn" onclick="toggleTheme()" aria-label="Toggle color scheme">dark</button>
          <a class="nav-btn" href="/">home</a>
        </div>
      </div>
    </header>

    <main class="wrap">
      <slot />
    </main>

    <footer class="foot">
      <div class="wrap foot-inner">
        <p class="foot-copy">© Justin Chua · Taipei</p>
        <p class="colophon">
          <a href="https://github.com/juscxnn/juscxnn.github.io" rel="noopener">view source →</a>
        </p>
      </div>
    </footer>
  </body>
</html>
