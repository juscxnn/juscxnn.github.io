---
import "../styles/global.css";
import { studies } from "../data/studies";

const LINKS = {
  GATEKEEP: "https://gatekeep.vc",
  GATEKEEP_CODE: "https://gatekeep.vc/?code=JCXA",
  ATTITEUD: "https://attiteud.com",
  CLIQUE: "https://clique.tech",
  ZAOBAO: "https://www.zaobao.com.sg/news/singapore/story20240102-1459510",
  LINKEDIN: "https://linkedin.com/in/justincxa",
  GITHUB: "https://github.com/juscxnn",
  SOURCE: "https://github.com/juscxnn/juscxnn.github.io",
};
const EMAIL = "jcxa@proton.me";

const faviconSvg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32"><g fill="#000">${[0, 60, 120, 180, 240, 300]
  .map((a) => `<ellipse cx="16" cy="8.5" rx="4" ry="7.5" transform="rotate(${a} 16 16)"/>`)
  .join("")}</g></svg>`;
const favicon = `data:image/svg+xml,${encodeURIComponent(faviconSvg)}`;

const description = "Justin Chua — software, distribution, deals. Taipei.";
const ogImage = new URL("/og.png", Astro.site);

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Justin Chua",
  url: Astro.site?.toString(),
  email: `mailto:${EMAIL}`,
  description,
  jobTitle: "Founder",
  worksFor: { "@type": "Organization", name: "Gatekeep", url: "https://gatekeep.vc" },
  address: { "@type": "PostalAddress", addressLocality: "Taipei" },
  knowsLanguage: ["en", "zh", "fr"],
  sameAs: [LINKS.LINKEDIN, LINKS.GITHUB, LINKS.GATEKEEP, LINKS.ATTITEUD],
});

const stats = [
  {
    eyebrow: "maritime · 2020–24",
    number: "75%",
    line: "of SG harbour craft digitalized · elxa",
    href: LINKS.ZAOBAO,
    link: "联合早报 →",
    lang: "zh-Hans",
  },
  {
    eyebrow: "ai saas · 2022–24",
    number: "2 exits",
    line: "CopyScouts 14x · Podletter 7x · AI Starter #2 PH",
    sub: "AI content SaaS · newsletter tool · AI launchpad",
  },
  {
    eyebrow: "clique · 2025– · sales lead + product",
    number: "US$10bn+",
    line: "distributed in 2 years · airdrops · bespoke distribution tooling",
    sub: "75% of top-1000 coins that outsourced development",
    href: LINKS.CLIQUE,
    link: "clique.tech →",
  },
];

const projects = [
  {
    name: "Gatekeep",
    blurb:
      "AI investor personas screen your pitch across 12 dimensions. Pass, and your deck lands with real VCs who fund founders like you.",
    href: LINKS.GATEKEEP,
    domain: "gatekeep.vc",
  },
  {
    name: "Attiteud",
    blurb:
      "Build studio + Humbl Design. Launch your startup in 2-4 weeks. One team, one price. $10K/mo.",
    href: LINKS.ATTITEUD,
    domain: "attiteud.com",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Justin Chua</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={Astro.site} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#FFFFFF" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#111111" />
    <meta property="og:title" content="Justin Chua" />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.site} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <script type="application/ld+json" set:html={jsonLd} />
    <script>
      (function () {
        var t = localStorage.getItem("theme");
        if (!t) t = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        document.documentElement.setAttribute("data-theme", t);
        document.addEventListener("DOMContentLoaded", function () {
          var b = document.querySelector(".theme-btn");
          if (b) b.textContent = t === "dark" ? "light" : "dark";
        });
        window.toggleTheme = function () {
          var c = document.documentElement.getAttribute("data-theme");
          var n = c === "dark" ? "light" : "dark";
          document.documentElement.setAttribute("data-theme", n);
          localStorage.setItem("theme", n);
          var b = document.querySelector(".theme-btn");
          if (b) b.textContent = n === "dark" ? "light" : "dark";
        };
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#top">skip to content</a>

    <header class="nav">
      <div class="wrap nav-inner">
        <a class="wordmark" href="/">Justin Chua</a>
        <div class="nav-right">
          <a class="nav-btn" href="/studies">writings</a>
          <button class="nav-btn theme-btn" onclick="toggleTheme()" aria-label="Toggle color scheme">dark</button>
          <button class="nav-btn lang" onclick="toggleLang()" title="切换中文">繁中</button>
        </div>
      </div>
    </header>

    <main id="top" class="wrap">
      <section class="hero" aria-label="Introduction">
        <p class="eyebrow" data-i18n="hero.eyebrow">TAIPEI · HK · SG</p>
        <h1 data-i18n="hero.headline">Justin Chua</h1>
        <p class="lede" data-i18n="hero.lede">
          I'm the kind of person who takes things apart to see how they work. A decade of that has
          taken me through maritime software, AI tools, and the plumbing of crypto markets. Two
          exits along the way, and more than US$10bn in token value moved through Clique. Right now
          I'm building Gatekeep, which helps founders meet the investors who fund them, and
          Attiteud, a studio that launches companies. Off the clock I'm usually reading, scribbling
          notes, and chasing questions about how people think, decide, and talk themselves into
          things.
        </p>
        <p class="timeline" data-i18n="hero.timeline">
          2014 police SOC · 2017 robotics sales · 2020 maritime · 2022 CopyScouts exit 14x · 2024
          Podletter exit 7x · 2025 Clique · 2026 Attiteud + Gatekeep
        </p>
        <div class="hero-ctas">
          <a href={LINKS.GATEKEEP_CODE} rel="noopener" data-i18n="hero.cta-gatekeep">
            try Gatekeep · 2 months free →
          </a>
          <a href="/studies" data-i18n="hero.cta-writings">writings →</a>
          <a href="#contact">contact</a>
        </div>
        <p class="kbw-line">
          <a href="/kbw">KBW Seoul · ad space on 4 dresses — claim a lot →</a>
        </p>
      </section>

      <section class="section" id="gatekeep" aria-label="Gatekeep">
        <h2 class="sec-title" data-i18n="gk.title">
          Pass the screen. <em>Meet the investors.</em> Get funded.
        </h2>
        <p class="gk-sub" data-i18n="gk.sub">
          AI investor personas stress-test your pitch across 12 dimensions. Pass the screen, and
          your deck goes straight to real VCs. 2 months free with the code:
        </p>
        <div class="gk-row">
          <button class="gk-code" onclick="copyGatekeepCode(this)" aria-label="Copy code JCXA">
            <span>JCXA</span>
            <span class="gk-code-action">copy</span>
          </button>
          <a href={LINKS.GATEKEEP_CODE} rel="noopener" data-i18n="gk.cta">start pitching →</a>
        </div>
      </section>

      <section class="section" id="building" aria-label="Building now">
        <h2 class="sec-title" data-i18n="label.building-now">building now</h2>
        {
          projects.map((p) => (
            <p class="proj-line">
              <span class="proj-name">{p.name}</span> — <span class="proj-blurb">{p.blurb}</span>{" "}
              <a class="proj-link" href={p.href} rel="noopener">{p.domain} →</a>
            </p>
          ))
        }
      </section>

      <section class="section" id="track-record" aria-label="Track record">
        <h2 class="sec-title" data-i18n="label.track-record">track record</h2>
        {
          stats.map((s) => (
            <p class="stat-line">
              <span class="stat-number">{s.number}</span> — {s.line}
              {s.sub && <span class="stat-sub"> · {s.sub}</span>}
              {s.href && (
                <>
                  {" "}
                  <a href={s.href} rel="noopener" lang={s.lang}>{s.link}</a>
                </>
              )}
            </p>
          ))
        }
        <!-- PENDING internal clearance on figures. -->
      </section>

      <section class="section" id="writings" aria-label="Writings">
        <h2 class="sec-title" data-i18n="label.writings">
          writings <a class="sec-link" href="/studies">(all →)</a>
        </h2>
        {
          [...studies]
            .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
            .slice(0, 9)
            .map((s) => {
              const d = new Date(s.date).toLocaleDateString("en-US", {
                month: "short",
                year: "numeric",
              });
              return (
                <a class="writing-row" href={`/studies/${s.slug}`}>
                  <span class="writing-date">{d}</span>
                  {s.title}
                  <span class="writing-tag">{s.backlinkLabel || "note"}</span>
                </a>
              );
            })
        }
      </section>

      <section class="section" id="certificates" aria-label="Certificates">
        <h2 class="sec-title" data-i18n="label.certificates">certificates</h2>
        <ul>
          <li>AI4I Foundations in AI · AI Singapore</li>
          <li>CrewAI · multi-agent systems</li>
          <li>UX Design · Vertical Institute</li>
          <li>Economics &amp; Int'l Business · IBMI</li>
          <li>CDMS</li>
        </ul>
      </section>

      <section class="section" id="contact" aria-label="Contact">
        <h2 class="sec-title" data-i18n="label.contact">contact</h2>
        <div class="contact-strip">
          <a class="contact-item" href="https://wa.me/6588175879" rel="noopener">
            <span data-i18n="contact.whatsapp">WhatsApp</span>
          </a>
          <a class="contact-item" href={LINKS.LINKEDIN} rel="noopener">
            <span data-i18n="contact.linkedin">LinkedIn</span>
          </a>
          <a class="contact-item" href={`mailto:${EMAIL}`}>
            <span data-i18n="contact.email">Email</span>
          </a>
          <a class="contact-item" href="/contact.vcf" download="Justin_Chua.vcf">
            <span data-i18n="contact.save">Save vCard</span>
          </a>
        </div>
      </section>
    </main>

    <footer class="foot">
      <div class="wrap foot-inner">
        <p class="foot-copy" data-i18n="footer.copy">© Justin Chua · Taipei</p>
        <p class="colophon">
          <span data-i18n="colophon">plain html · no frameworks · system fonts ·</span>
          <a href={LINKS.SOURCE} rel="noopener">view source →</a>
        </p>
      </div>
    </footer>

    <script>
      /* ── gatekeep code copy ── */
      window.copyGatekeepCode = function (btn) {
        var code = "JCXA";
        var done = function () {
          var a = btn.querySelector(".gk-code-action");
          if (a) { a.textContent = "copied"; setTimeout(function () { a.textContent = "copy"; }, 1800); }
        };
        function fallback() {
          var ta = document.createElement("textarea");
          ta.value = code;
          ta.style.position = "fixed";
          ta.style.opacity = "0";
          document.body.appendChild(ta);
          ta.select();
          try { document.execCommand("copy"); } catch (e) {}
          document.body.removeChild(ta);
          done();
        }
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(code).then(done).catch(fallback);
        } else {
          fallback();
        }
      };

      /* ── i18n ── */
      (function () {
        var M = {
          zh: {
            "hero.eyebrow": "台北 · 香港 · 新加坡",
            "hero.headline": "蔡献安",
            "hero.lede": "我是那种喜欢拆开东西看它们怎么工作的人。十年里走过海事软件、AI 工具和加密市场的底层架构。两次退出，经 Clique 流动了 100 亿美元+ 代币。现在我在做 Gatekeep，帮创始人见到真正投资的人；还有 Attiteud，一个帮刚开始的公司的启动的工作室。不工作时我通常在读书、写笔记，追问人们怎么思考、怎么决定、怎么说服自己的问题。",
            "hero.timeline": "2014 警察特勤 · 2017 机器人销售 · 2020 海事 · 2022 CopyScouts 14x 退出 · 2024 Podletter 7x 退出 · 2025 Clique · 2026 Attiteud + Gatekeep",
            "hero.cta-gatekeep": "试用 Gatekeep · 免费 2 个月 →",
            "hero.cta-writings": "文章 →",
            "gk.title": "通过 AI 筛选。见到真实投资人。拿到融资。",
            "gk.sub": "AI 投资人角色对你的路演进行 12 维度压力测试。通过筛选后，你的 deck 直达真实 VC。使用代码免费 2 个月：",
            "gk.cta": "开始路演 →",
            "label.building-now": "正在打造",
            "label.track-record": "业绩记录",
            "label.writings": "文章",
            "label.certificates": "证书",
            "label.contact": "联系",
            "contact.whatsapp": "WhatsApp",
            "contact.linkedin": "LinkedIn",
            "contact.email": "邮件",
            "contact.save": "保存名片",
            "footer.copy": "© 蔡献安 · 台北",
            "colophon": "纯 HTML · 无框架 · 系统字体 ·",
          },
        };
        var cur = "en";
        window.applyLang = function (lang) {
          cur = lang;
          document.documentElement.setAttribute("data-lang", lang);
          document.querySelectorAll("[data-i18n]").forEach(function (el) {
            var k = el.getAttribute("data-i18n");
            var orig = el.getAttribute("data-i18n-orig");
            if (!orig) { el.setAttribute("data-i18n-orig", el.textContent); orig = el.textContent; }
            if (lang === "zh" && M.zh[k]) el.textContent = M.zh[k];
            else el.textContent = orig;
          });
          var b = document.querySelector(".lang");
          if (b) b.textContent = lang === "zh" ? "EN" : "繁中";
        };
        window.toggleLang = function () {
          applyLang(cur === "zh" ? "en" : "zh");
          localStorage.setItem("lang", cur);
        };
        var s = localStorage.getItem("lang");
        if (s === "zh") applyLang("zh");
      })();
    </script>
  </body>
</html>
