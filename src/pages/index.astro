---
import "../styles/global.css";
import "../styles/game.css";
import { EMAIL } from "../data/site";

const description =
  "A Doodle Jump through Justin Chua's timeline. 2014 police SOC, robotics, maritime, two exits, Clique, Gatekeep, Attiteud. Web and installable as an app.";
const canonical = new URL("/", Astro.site);
const ogImage = new URL("/og.png", Astro.site);

const faviconSvg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32"><g fill="#1C5C3A">${[0, 60, 120, 180, 240, 300]
  .map((a) => `<ellipse cx="16" cy="8.5" rx="4" ry="7.5" transform="rotate(${a} 16 16)"/>`)
  .join("")}</g></svg>`;
const favicon = `data:image/svg+xml,${encodeURIComponent(faviconSvg)}`;

const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Justin Chua",
  url: Astro.site?.toString(),
  email: `mailto:${EMAIL}`,
  description,
  jobTitle: "Sales Lead & Product",
  worksFor: { "@type": "Organization", name: "Clique", url: "https://clique.tech" },
  founder: [
    { "@type": "Organization", name: "Gatekeep", url: "https://gatekeep.vc" },
    { "@type": "Organization", name: "Attiteud", url: "https://attiteud.com" },
  ],
  address: { "@type": "PostalAddress", addressLocality: "Taipei" },
  knowsLanguage: ["en", "zh", "fr"],
};

const game = {
  "@context": "https://schema.org",
  "@type": "VideoGame",
  name: "The Climb",
  description,
  genre: "Platformer",
  gamePlatform: "Web browser",
  applicationCategory: "Game",
  operatingSystem: "Any",
  author: { "@type": "Person", name: "Justin Chua", url: Astro.site?.toString() },
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};

const jsonLd = JSON.stringify([person, game]);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>The Climb — Justin Chua</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#F7F4EC" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#14140F" />
    <meta property="og:title" content="The Climb — Justin Chua" />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="The Climb" />
    <script type="application/ld+json" set:html={jsonLd} />
    <script is:inline>
      (function () {
        var t = localStorage.getItem("theme");
        if (!t) t = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        document.documentElement.setAttribute("data-theme", t);
      })();
    </script>
  </head>
  <body class="game-body">
    <main class="stage" id="stage">
      <div class="col">
        <canvas id="world" class="world" aria-hidden="true"></canvas>

        <div class="hud">
          <div class="hud-left">
            <span class="hud-year" id="hud-year">2014</span>
            <span class="hud-era" id="hud-era">Police SOC</span>
          </div>
          <div class="hud-right">
            <span class="hud-best-pill"><span id="hud-best">0m</span></span>
            <button class="icon-btn" id="btn-pause" aria-label="Pause">II</button>
          </div>
        </div>

        <div class="rail" aria-hidden="true">
          <div class="rail-track"><span class="rail-fill" id="rail-fill"></span></div>
          <div class="rail-ticks" id="rail-ticks"></div>
        </div>

        <div class="cards" id="cards"></div>
        <div class="toast" id="toast" role="status" aria-live="polite"></div>
      </div>

      <section class="overlay" id="screen-start">
        <div class="screen-in">
          <p class="eyebrow">TAIPEI · 2014 → NOW</p>
          <h1 data-i18n="title">The Climb</h1>
          <p class="lede" data-i18n="subtitle">
            2014 → now. Auto-bounce. Steer. Every platform is something I did.
          </p>
          <p class="bio-line">
            I build software and get it distributed. Sales lead and product at Clique. Founder of
            Gatekeep and Attiteud, a holding company for small tech bets.
          </p>
          <p class="howto" data-i18n="howto">← → or A / D · touch left / right</p>
          <div class="actions">
            <button class="primary" id="btn-start" data-i18n="start">start climbing</button>
            <a class="ghost js-about" href="/about/" data-i18n="readFlat">read the flat version</a>
          </div>
          <div class="mini-row">
            <span class="mini-label" data-i18n="best">best</span>
            <span class="mini-value" id="start-best">0m</span>
            <span class="mini-sep">·</span>
            <a class="js-studies" href="/studies/" data-i18n="writing">writing</a>
            <a class="js-github" href="https://github.com/juscxnn" rel="noopener">github</a>
            <a class="js-linkedin" href="https://linkedin.com/in/justincxa" rel="noopener">linkedin</a>
            <a class="js-email" href="mailto:jcxa@proton.me" data-i18n="contact">get in touch</a>
          </div>
          <div class="toggles">
            <button class="tog js-lang" data-i18n="langName">繁中</button>
            <button class="tog js-theme">dark</button>
            <button class="tog js-sound">sound: off</button>
            <button class="tog js-install" data-i18n="install" hidden>install app</button>
          </div>
        </div>
      </section>

      <section class="overlay hidden" id="screen-pause">
        <div class="panel">
          <p class="eyebrow" data-i18n="paused">paused</p>
          <h2 data-i18n="climbLog">climb log</h2>
          <p class="stats" id="pause-stats"></p>
          <div class="log" id="pause-log"></div>
          <div class="actions">
            <button class="primary" id="btn-resume" data-i18n="resume">resume</button>
            <button class="ghost" id="btn-restart" data-i18n="restart">restart</button>
          </div>
          <div class="toggles">
            <button class="tog js-lang">繁中</button>
            <button class="tog js-theme">dark</button>
            <button class="tog js-sound">sound: off</button>
            <button class="tog js-install" data-i18n="install" hidden>install app</button>
          </div>
          <div class="mini-row">
            <a class="js-about" href="/about/" data-i18n="about">about</a>
            <a class="js-studies" href="/studies/" data-i18n="allWriting">all writing</a>
            <a class="js-email" href="mailto:jcxa@proton.me" data-i18n="contact">get in touch</a>
          </div>
        </div>
      </section>

      <section class="overlay hidden" id="screen-finale">
        <div class="panel finale">
          <p class="eyebrow">NOW · 2026 · TAIPEI</p>
          <h2 data-i18n="finaleTitle">You made it.</h2>
          <p class="lede" data-i18n="finaleSub">Two exits. One holding company. Still shipping.</p>
          <p class="stats" id="finale-stats"></p>
          <div class="log" id="finale-log"></div>

          <div class="now-grid">
            <div class="now-card">
              <p class="now-name">Gatekeep</p>
              <p class="now-text" data-i18n="nowGatekeep">
                AI-native operating system for venture. Pitch the bar, not the network.
              </p>
              <div class="now-actions">
                <button class="code js-copy">JCXA</button>
                <a class="js-gatekeep" href="https://gatekeep.vc" rel="noopener">gatekeep.vc ↗</a>
              </div>
            </div>
            <div class="now-card">
              <p class="now-name">Attiteud</p>
              <p class="now-text" data-i18n="nowAttiteud">
                Holding company. Owns and builds a portfolio of small tech bets.
              </p>
              <div class="now-actions">
                <a class="js-attiteud" href="https://attiteud.com" rel="noopener">attiteud.com ↗</a>
              </div>
            </div>
          </div>

          <div class="contact-grid">
            <a class="js-email" href="mailto:jcxa@proton.me">email</a>
            <a class="js-whatsapp" href="https://wa.me/6588175879" rel="noopener">whatsapp</a>
            <a class="js-linkedin" href="https://linkedin.com/in/justincxa" rel="noopener">linkedin</a>
            <a class="js-github" href="https://github.com/juscxnn" rel="noopener">github</a>
            <a class="js-vcf" href="/contact.vcf" download="Justin_Chua.vcf" data-i18n="saveContact">save contact</a>
            <a class="js-studies" href="/studies/" data-i18n="allWriting">all writing</a>
          </div>

          <div class="actions">
            <button class="primary" id="btn-again" data-i18n="playAgain">climb again</button>
            <button class="tog js-install" data-i18n="install" hidden>install app</button>
            <a class="ghost js-about" href="/about/" data-i18n="about">about</a>
          </div>
        </div>
      </section>

      <noscript>
        <div class="noscript-flat">
          <h1>Justin Chua</h1>
          <p>
            I build software and get it distributed. Sales lead and product at Clique. Founder of
            Gatekeep and Attiteud, a holding company for small tech bets. Two exits, US$10bn+
            distributed.
          </p>
          <p>
            2014 police SOC · 2017 robotics sales · 2020 maritime · 2022 CopyScouts exit 14x · 2024
            Podletter exit 7x · 2025 Clique · 2026 Gatekeep + Attiteud
          </p>
          <p>
            <a href="/about/">About</a> · <a href="/studies/">Writing</a> ·
            <a href="mailto:jcxa@proton.me">Email</a> ·
            <a href="https://linkedin.com/in/justincxa">LinkedIn</a> ·
            <a href="https://github.com/juscxnn">GitHub</a>
          </p>
        </div>
      </noscript>
    </main>

    <script>
      import "../game/main";
    </script>
  </body>
</html>
