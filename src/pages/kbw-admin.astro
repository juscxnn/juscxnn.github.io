---
import "../styles/global.css";
import { kbw, buildLots } from "../data/kbw";

// ── CHANGE YOUR PASSWORD HERE ─────────────────────────────
// Compute the hash:  printf 'your-password' | shasum -a 256
const PASSWORD_HASH = "eea680850623b33e5ada75f671c70f707b06a05a8901f9cbbe27d5488323b5cd";
// ───────────────────────────────────────────────────────────

const REPO_OWNER = "juscxnn";
const REPO_NAME = "juscxnn.github.io";
const REPO_BRANCH = "main";
const STATUS_PATH = "src/data/kbw-status.json";
const SITE_URL = "https://justinxa.com";

const lots = buildLots();
const girls = kbw.girls;
const days = kbw.days;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>KBW admin</title>
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="light dark" />
    <script>
      (function () {
        var t = localStorage.getItem("theme");
        if (!t) t = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        document.documentElement.setAttribute("data-theme", t);
        window.toggleTheme = function () {
          var c = document.documentElement.getAttribute("data-theme");
          var n = c === "dark" ? "light" : "dark";
          document.documentElement.setAttribute("data-theme", n);
          localStorage.setItem("theme", n);
        };
      })();
    </script>
  </head>
  <body>
    <header class="nav">
      <div class="wrap nav-inner">
        <a class="wordmark" href="/">Justin Chua</a>
        <div class="nav-right">
          <a class="nav-btn" href="/kbw">campaign</a>
          <button class="nav-btn" onclick="toggleTheme()" aria-label="Toggle color scheme">theme</button>
        </div>
      </div>
    </header>

    <main class="wrap">
      <!-- password gate -->
      <div id="gate" class="gate">
        <div class="gate-card">
          <p class="gate-title">kbw admin</p>
          <input id="gate-input" class="inp" type="password" placeholder="password" autocomplete="current-password" />
          <button class="btn" onclick="tryUnlock()">unlock</button>
          <p id="gate-err" class="err" hidden>wrong password</p>
        </div>
      </div>

      <!-- admin -->
      <div id="admin" hidden>
        <div class="head">
          <h1>KBW admin</h1>
          <button class="btn ghost" onclick="lock()">lock</button>
        </div>

        <div class="token-row">
          <label class="field">
            <span class="lbl">github token (contents read + write)</span>
            <input id="token" class="inp" type="password" placeholder="github_pat_..." />
          </label>
          <button class="btn" onclick="loadStatus()">load / refresh</button>
        </div>
        <p id="msg" class="msg"></p>

        <div id="tiles" class="tiles"></div>

        <p class="hint">
          Tap a spot to edit. <strong>open</strong> = available · <strong>pending</strong> = payment
          sent, verifying · <strong>sold</strong> = confirmed. Save commits the status file and the
          logo (if uploaded), and the site redeploys in ~1 minute.
        </p>
      </div>

      <!-- editor -->
      <div id="editor" class="editor" hidden>
        <div class="editor-card">
          <button class="close" onclick="closeEditor()" aria-label="Close">✕</button>
          <p class="eyebrow" id="e-title">—</p>

          <div class="seg" id="e-status">
            <button class="seg-btn" data-val="open">open</button>
            <button class="seg-btn" data-val="pending">pending</button>
            <button class="seg-btn" data-val="sold">sold</button>
          </div>

          <label class="field"><span class="lbl">brand name</span><input id="e-brand" class="inp" placeholder="Acme" /></label>
          <label class="field"><span class="lbl">website</span><input id="e-url" class="inp" placeholder="https://acme.com" /></label>
          <label class="field"><span class="lbl">logo url (or upload below)</span><input id="e-logo" class="inp" placeholder="https://acme.com/logo.png" /></label>
          <label class="field"><span class="lbl">upload logo file</span><input id="e-file" class="inp" type="file" accept="image/*" /></label>

          <div class="editor-actions">
            <button class="btn" onclick="saveLot()" id="e-save">save</button>
            <button class="btn ghost" onclick="closeEditor()">cancel</button>
          </div>
        </div>
      </div>
    </main>

    <script type="application/json" id="admin-config" set:html={JSON.stringify({
      hash: PASSWORD_HASH,
      owner: REPO_OWNER,
      repo: REPO_NAME,
      branch: REPO_BRANCH,
      statusPath: STATUS_PATH,
      site: SITE_URL,
      lots: lots.map((l) => ({
        id: l.id,
        girl: l.girl,
        girlName: l.girlName,
        day: l.day,
        dayLabel: l.dayLabel,
        side: l.side,
        price: l.price,
      })),
    })}></script>

    <script>
      const CFG = JSON.parse(document.getElementById("admin-config").textContent);
      const HASH = CFG.hash;
      const OWNER = CFG.owner, REPO = CFG.repo, BRANCH = CFG.branch;
      const STATUS_PATH = CFG.statusPath;
      const SITE = CFG.site;
      const LOTS = CFG.lots;

      let status = {};
      let statusSha = null;
      let editing = null;
      let editStatus = "open";

      /* ── gate ── */
      function sha256(str) {
        return crypto.subtle.digest("SHA-256", new TextEncoder().encode(str)).then((b) =>
          Array.from(new Uint8Array(b)).map((x) => x.toString(16).padStart(2, "0")).join("")
        );
      }
      function tryUnlock() {
        sha256(document.getElementById("gate-input").value).then((h) => {
          if (h === HASH) {
            sessionStorage.setItem("kbw_admin", "1");
            showAdmin();
          } else {
            document.getElementById("gate-err").hidden = false;
          }
        });
      }
      function lock() {
        sessionStorage.removeItem("kbw_admin");
        location.reload();
      }
      document.getElementById("gate-input").addEventListener("keydown", (e) => {
        if (e.key === "Enter") tryUnlock();
      });
      function showAdmin() {
        document.getElementById("gate").hidden = true;
        document.getElementById("admin").hidden = false;
        document.getElementById("token").value = localStorage.getItem("gh_token") || "";
        if (document.getElementById("token").value) loadStatus();
      }
      if (sessionStorage.getItem("kbw_admin") === "1") showAdmin();

      /* ── github ── */
      function gh(path, method, token, body) {
        return fetch("https://api.github.com" + path, {
          method,
          headers: {
            Authorization: "Bearer " + token,
            Accept: "application/vnd.github+json",
            "X-GitHub-Api-Version": "2022-11-28",
          },
          body: body ? JSON.stringify(body) : undefined,
        }).then((r) =>
          r.json().then((j) => {
            if (!r.ok) {
              const e = new Error(j.message || r.statusText);
              e.status = r.status;
              throw e;
            }
            return j;
          })
        );
      }
      const b64 = (s) => btoa(unescape(encodeURIComponent(s)));
      const unb64 = (s) => decodeURIComponent(escape(atob(s)));

      function token() {
        const t = document.getElementById("token").value.trim();
        localStorage.setItem("gh_token", t);
        return t;
      }
      function msg(text, kind) {
        const el = document.getElementById("msg");
        el.textContent = text;
        el.className = "msg " + (kind || "");
      }

      /* ── load ── */
      function loadStatus() {
        const t = token();
        if (!t) return msg("paste a github token first", "err");
        msg("loading…");
        gh(`/repos/${OWNER}/${REPO}/contents/${STATUS_PATH}?ref=${BRANCH}`, "GET", t)
          .then((res) => {
            statusSha = res.sha;
            status = JSON.parse(unb64(res.content.replace(/\n/g, "")));
            msg("loaded · " + Object.keys(status).length + " spots set", "ok");
            renderTiles();
          })
          .catch((e) => msg("load failed: " + e.message, "err"));
      }

      /* ── tiles ── */
      function entryOf(id) {
        const e = status[id];
        if (!e) return null;
        return typeof e === "string" ? { status: e } : e;
      }
      function renderTiles() {
        const byGirl = {};
        LOTS.forEach((l) => (byGirl[l.girl] = byGirl[l.girl] || []).push(l));
        document.getElementById("tiles").innerHTML = Object.keys(byGirl)
          .map((g) => {
            const items = byGirl[g]
              .map((l) => {
                const e = entryOf(l.id);
                const st = e ? e.status : "open";
                const label = e && e.brand ? e.brand : st;
                return `<button class="tile ${st}" data-lot="${l.id}">
                  <span class="tile-day">${l.dayLabel}</span>
                  <span class="tile-side">${l.side}</span>
                  <span class="tile-st">${label}</span>
                </button>`;
              })
              .join("");
            return `<div class="tile-group"><p class="tile-girl">${byGirl[g][0].girlName}</p><div class="tile-grid">${items}</div></div>`;
          })
          .join("");
        document.querySelectorAll(".tile").forEach((el) =>
          el.addEventListener("click", () => openEditor(el.dataset.lot))
        );
      }

      /* ── editor ── */
      function openEditor(id) {
        editing = id;
        const l = LOTS.find((x) => x.id === id);
        const e = entryOf(id) || { status: "open" };
        editStatus = e.status || "open";
        document.getElementById("e-title").textContent = `${l.girlName} · ${l.dayLabel} · ${l.side}`;
        document.getElementById("e-brand").value = e.brand || "";
        document.getElementById("e-url").value = e.url || "";
        document.getElementById("e-logo").value = e.logo || "";
        document.getElementById("e-file").value = "";
        setStatus(editStatus);
        document.getElementById("editor").hidden = false;
      }
      function setStatus(v) {
        editStatus = v;
        document.querySelectorAll("#e-status .seg-btn").forEach((b) =>
          b.classList.toggle("on", b.dataset.val === v)
        );
      }
      document.querySelectorAll("#e-status .seg-btn").forEach((b) =>
        b.addEventListener("click", () => setStatus(b.dataset.val))
      );
      window.closeEditor = () => {
        document.getElementById("editor").hidden = true;
        editing = null;
      };

      /* ── save ── */
      async function saveLot() {
        const t = token();
        if (!t) return msg("paste a github token first", "err");
        const id = editing;
        const btn = document.getElementById("e-save");
        btn.disabled = true;
        msg("saving…");
        try {
          let logo = document.getElementById("e-logo").value.trim();
          const file = document.getElementById("e-file").files[0];

          // upload logo file if selected
          if (file) {
            msg("uploading logo…");
            const ext = (file.name.split(".").pop() || "png").toLowerCase();
            const path = `public/kbw/logos/${id}.${ext}`;
            const dataUrl = await new Promise((res) => {
              const fr = new FileReader();
              fr.onload = () => res(fr.result);
              fr.readAsDataURL(file);
            });
            const content = dataUrl.split(",")[1];
            let fileSha = null;
            try {
              const cur = await gh(`/repos/${OWNER}/${REPO}/contents/${path}?ref=${BRANCH}`, "GET", t);
              fileSha = cur.sha;
            } catch (e) {
              if (e.status !== 404) throw e;
            }
            await gh(`/repos/${OWNER}/${REPO}/contents/${path}`, "PUT", t, {
              message: `KBW logo: ${id}`,
              content,
              branch: BRANCH,
              ...(fileSha ? { sha: fileSha } : {}),
            });
            logo = `/kbw/logos/${id}.${ext}`;
          }

          // update status object
          const brand = document.getElementById("e-brand").value.trim();
          const url = document.getElementById("e-url").value.trim();
          if (editStatus === "open" && !brand) {
            delete status[id];
          } else {
            const entry = { status: editStatus === "open" ? "pending" : editStatus };
            if (brand) entry.brand = brand;
            if (url) entry.url = url;
            if (logo) entry.logo = logo;
            status[id] = entry;
          }

          // re-fetch sha to avoid conflicts, then commit
          msg("committing…");
          const fresh = await gh(`/repos/${OWNER}/${REPO}/contents/${STATUS_PATH}?ref=${BRANCH}`, "GET", t);
          await gh(`/repos/${OWNER}/${REPO}/contents/${STATUS_PATH}`, "PUT", t, {
            message: `KBW status: ${id} → ${editStatus}${brand ? " (" + brand + ")" : ""}`,
            content: b64(JSON.stringify(status, null, 2) + "\n"),
            sha: fresh.sha,
            branch: BRANCH,
          });
          statusSha = fresh.sha;
          msg("saved. site redeploys in ~1 min → " + SITE + "/kbw", "ok");
          renderTiles();
          closeEditor();
        } catch (e) {
          msg("save failed: " + e.message, "err");
        }
        btn.disabled = false;
      }
    </script>

    <style>
      .gate { display: grid; place-items: center; min-height: 60vh; }
      .gate-card { border: 1px solid var(--hairline); padding: 28px; display: flex; flex-direction: column; gap: 12px; width: min(92vw, 340px); }
      .gate-title { font-family: var(--mono); text-transform: uppercase; letter-spacing: 0.1em; font-size: 12px; margin: 0 0 6px; color: var(--muted); }
      .inp { font-family: var(--mono); font-size: 13.5px; padding: 9px 11px; border: 1px solid var(--hairline); background: var(--bg); color: var(--ink); width: 100%; }
      .btn { font-family: var(--mono); font-size: 12.5px; background: var(--ink); color: var(--bg); border: 1px solid var(--ink); padding: 10px 16px; cursor: pointer; }
      .btn:hover { opacity: 0.85; }
      .btn.ghost { background: none; color: var(--ink); }
      .btn:disabled { opacity: 0.5; cursor: wait; }
      .err { color: #b3261e; font-family: var(--mono); font-size: 12px; margin: 0; }
      .msg { font-family: var(--mono); font-size: 12px; color: var(--muted); min-height: 1.2em; margin: 0.5rem 0 1rem; }
      .msg.ok { color: var(--ink); }
      .msg.err { color: #b3261e; }

      .head { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding-block: 1.5rem 1rem; }
      .head h1 { margin: 0; font-size: 1.5rem; }
      .token-row { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 10px; }
      .field { display: flex; flex-direction: column; gap: 4px; flex: 1; min-width: 220px; }
      .lbl { font-family: var(--mono); font-size: 10px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); }

      .tiles { display: grid; gap: 18px; margin-bottom: 1rem; }
      .tile-group { border: 1px solid var(--hairline); padding: 14px; }
      .tile-girl { margin: 0 0 10px; font-weight: 700; }
      .tile-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
      .tile { text-align: left; border: 1px solid var(--hairline); background: var(--bg); color: var(--ink); padding: 10px; cursor: pointer; display: flex; flex-direction: column; gap: 2px; }
      .tile:hover { border-color: var(--ink); }
      .tile-day { font-weight: 700; font-size: 14px; }
      .tile-side { font-family: var(--mono); font-size: 10.5px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); }
      .tile-st { font-family: var(--mono); font-size: 11px; margin-top: 4px; }
      .tile.pending { background: #FFF7E0; border-color: #C8A24A; }
      .tile.sold { background: var(--ink); color: var(--bg); border-color: var(--ink); }
      .tile.sold .tile-side, .tile.sold .tile-st { color: var(--bg); opacity: 0.85; }
      [data-theme="dark"] .tile.pending { background: #2E2717; border-color: #7A6428; }

      .hint { font-size: 13px; color: var(--muted); max-width: 60ch; padding-bottom: 3rem; }

      .editor { position: fixed; inset: 0; background: rgba(0, 0, 0, 0.5); display: grid; place-items: center; z-index: 50; padding: 16px; }
      .editor[hidden] { display: none; }
      .editor-card { position: relative; background: var(--bg); border: 1px solid var(--hairline); padding: 22px; width: min(94vw, 440px); max-height: 92vh; overflow-y: auto; display: flex; flex-direction: column; gap: 10px; }
      .close { position: absolute; top: 10px; right: 12px; background: none; border: 0; font-size: 17px; cursor: pointer; color: var(--muted); }
      .seg { display: flex; gap: 6px; }
      .seg-btn { font-family: var(--mono); font-size: 12px; background: none; border: 1px solid var(--hairline); color: var(--ink); padding: 8px 14px; cursor: pointer; }
      .seg-btn.on { background: var(--ink); color: var(--bg); border-color: var(--ink); }
      .editor-actions { display: flex; gap: 8px; margin-top: 6px; }

      @media (max-width: 640px) {
        .tile-grid { grid-template-columns: repeat(2, 1fr); }
      }
    </style>
  </body>
</html>
