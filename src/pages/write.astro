---
import "../styles/global.css";

// ── CHANGE YOUR PASSWORD HERE ─────────────────────────────
// Compute the hash:  printf 'your-password' | shasum -a 256
const PASSWORD_HASH = "eea680850623b33e5ada75f671c70f707b06a05a8901f9cbbe27d5488323b5cd";
// ───────────────────────────────────────────────────────────

const REPO_OWNER = "juscxnn";
const REPO_NAME = "juscxnn.github.io";
const REPO_BRANCH = "main";
const SITE_URL = "https://juscxnn.github.io";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Writer · Justin Chua</title>
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#F5F1E9" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#17161A" />
    <script>
      (function () {
        var t = localStorage.getItem("theme");
        if (!t) t = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        document.documentElement.setAttribute("data-theme", t);
        window.toggleTheme = function () {
          var c = document.documentElement.getAttribute("data-theme");
          var n = c === "dark" ? "light" : "dark";
          document.documentElement.setAttribute("data-theme", n);
          localStorage.setItem("theme", n);
        };
      })();
    </script>
  </head>
  <body>
    <header class="nav">
      <div class="wrap nav-inner">
        <a class="wordmark" href="/">Justin Chua</a>
        <div class="nav-right">
          <button class="nav-btn theme-btn" onclick="toggleTheme()" aria-label="Toggle color scheme">dark</button>
          <a class="nav-btn" href="/">home</a>
        </div>
      </div>
    </header>

    <main class="wrap">
      <!-- ── password gate ── -->
      <div id="gate" class="gate">
        <div class="gate-card">
          <p class="gate-title">private writer</p>
          <input id="gate-input" class="gate-input" type="password" placeholder="password" autocomplete="current-password" />
          <button class="gate-btn" onclick="tryUnlock()">unlock</button>
          <p id="gate-err" class="gate-err" hidden>wrong password</p>
        </div>
      </div>

      <!-- ── editor ── -->
      <div id="editor" class="editor" hidden>
        <div class="editor-head">
          <h1>new writing</h1>
          <div class="editor-head-actions">
            <button class="ghost-btn" onclick="toggleTheme()">theme</button>
            <button class="ghost-btn" onclick="lock()">lock</button>
          </div>
        </div>

        <div class="editor-grid">
          <div class="editor-form">
            <label class="field">
              <span class="field-label">title</span>
              <input id="f-title" class="field-input" oninput="autoSlug()" placeholder="Title of the writing" />
            </label>
            <div class="field-row">
              <label class="field">
                <span class="field-label">slug</span>
                <input id="f-slug" class="field-input" placeholder="auto-from-title" />
              </label>
              <label class="field">
                <span class="field-label">date</span>
                <input id="f-date" class="field-input" type="date" />
              </label>
            </div>
            <label class="field">
              <span class="field-label">abstract (1–2 sentences)</span>
              <textarea id="f-abstract" class="field-input field-area-sm" rows="2" placeholder="Shows on the listing card and as the meta description."></textarea>
            </label>
            <div class="field-row">
              <label class="field">
                <span class="field-label">keywords (comma separated)</span>
                <input id="f-kw" class="field-input" placeholder="human behaviour, simulation, curiosity" />
              </label>
              <label class="field">
                <span class="field-label">tag (card label)</span>
                <input id="f-tag" class="field-input" value="writing" />
              </label>
            </div>
            <label class="field">
              <span class="field-label">body · markdown-lite</span>
              <div class="md-hint">## section · **bold** · *italic* · - list · ``` code · [text](url)</div>
              <textarea id="f-body" class="field-input field-area" rows="18" placeholder="## The Idea&#10;&#10;Write here. Two blank lines between paragraphs."></textarea>
            </label>

            <label class="field">
              <span class="field-label">github token (fine-grained, contents: read+write on {REPO_OWNER}/{REPO_NAME})</span>
              <input id="f-token" class="field-input" type="password" placeholder="ghp_... or github_pat_..." />
              <span class="field-note">stored only in your browser. creates one commit: the new study page + studies list.</span>
            </label>

            <div class="editor-actions">
              <button class="publish-btn" onclick="publish()" id="publish-btn">publish</button>
              <span id="pub-status" class="pub-status"></span>
            </div>
            <p id="pub-err" class="pub-err" hidden></p>
          </div>

          <div class="editor-preview">
            <p class="preview-label">preview</p>
            <div id="preview" class="preview"></div>
          </div>
        </div>
      </div>
    </main>

    <script type="application/json" id="writer-config" set:html={JSON.stringify({
      hash: PASSWORD_HASH,
      owner: REPO_OWNER,
      repo: REPO_NAME,
      branch: REPO_BRANCH,
      site: SITE_URL,
    })}></script>

    <script>
      /* ── config ── */
      var CFG = JSON.parse(document.getElementById("writer-config").textContent);
      var HASH = CFG.hash;
      var REPO_OWNER = CFG.owner;
      var REPO_NAME = CFG.repo;
      var REPO_BRANCH = CFG.branch;
      var SITE_URL = CFG.site;

      function sha256(str) {
        return crypto.subtle.digest("SHA-256", new TextEncoder().encode(str)).then(function (b) {
          return Array.from(new Uint8Array(b)).map(function (x) { return x.toString(16).padStart(2, "0"); }).join("");
        });
      }
      function tryUnlock() {
        var v = document.getElementById("gate-input").value;
        sha256(v).then(function (h) {
          if (h === HASH) {
            sessionStorage.setItem("writer_unlocked", "1");
            document.getElementById("gate").hidden = true;
            document.getElementById("editor").hidden = false;
            loadDraft();
          } else {
            document.getElementById("gate-err").hidden = false;
          }
        });
      }
      function lock() {
        sessionStorage.removeItem("writer_unlocked");
        document.getElementById("gate").hidden = false;
        document.getElementById("editor").hidden = true;
      }
      document.getElementById("gate-input").addEventListener("keydown", function (e) {
        if (e.key === "Enter") tryUnlock();
      });
      if (sessionStorage.getItem("writer_unlocked") === "1") {
        document.getElementById("gate").hidden = true;
        document.getElementById("editor").hidden = false;
        loadDraft();
      }

      /* ── draft autosave ── */
      var FIELDS = ["f-title", "f-slug", "f-date", "f-abstract", "f-kw", "f-tag", "f-body"];
      function saveDraft() {
        var d = {};
        FIELDS.forEach(function (id) { d[id] = document.getElementById(id).value; });
        d["f-token"] = document.getElementById("f-token").value;
        localStorage.setItem("writer_draft", JSON.stringify(d));
      }
      function loadDraft() {
        var raw = localStorage.getItem("writer_draft");
        if (!raw) {
          document.getElementById("f-date").value = new Date().toISOString().slice(0, 10);
          return;
        }
        var d = JSON.parse(raw);
        FIELDS.forEach(function (id) { document.getElementById(id).value = d[id] || ""; });
        document.getElementById("f-token").value = d["f-token"] || "";
        renderPreview();
      }
      FIELDS.forEach(function (id) {
        document.getElementById(id).addEventListener("input", function () {
          saveDraft();
          renderPreview();
        });
      });

      /* ── slug ── */
      function autoSlug() {
        var t = document.getElementById("f-title").value;
        var s = t.toLowerCase().replace(/[^a-z0-9\s-]/g, "").trim().replace(/\s+/g, "-").replace(/-+/g, "-");
        document.getElementById("f-slug").value = s;
      }

      /* ── markdown-lite ── */
      function esc(s) {
        return s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
      }
      function inline(s) {
        s = esc(s);
        s = s.replace(/\*\*(.+?)\*\*/g, "<strong data-astro-cid=\"s\">$1</strong>");
        s = s.replace(/\*(.+?)\*/g, "<em data-astro-cid=\"s\">$1</em>");
        s = s.replace(/`(.+?)`/g, "<code data-astro-cid=\"s\">$1</code>");
        s = s.replace(/\[([^\]]+)\]\(([^)]+)\)/g, "<a href=\"$2\" rel=\"noopener\" data-astro-cid=\"s\">$1</a>");
        return s;
      }
      function renderBlocks(src) {
        var lines = src.split("\n");
        var html = "";
        var para = [];
        var list = null;
        var code = null;
        function flushPara() {
          if (para.length) {
            html += "<p data-astro-cid=\"s\">" + inline(para.join(" ")) + "</p>";
            para = [];
          }
        }
        function flushList() {
          if (list) {
            html += (list.tag === "ul" ? "<ul data-astro-cid=\"s\">" : "<ol data-astro-cid=\"s\">");
            list.items.forEach(function (it) { html += "<li data-astro-cid=\"s\">" + inline(it) + "</li>"; });
            html += list.tag === "ul" ? "</ul>" : "</ol>";
            list = null;
          }
        }
        function flushCode() {
          if (code !== null) {
            html += "<pre data-astro-cid=\"s\"><code data-astro-cid=\"s\">" + esc(code.join("\n")) + "</code></pre>";
            code = null;
          }
        }
        for (var i = 0; i < lines.length; i++) {
          var ln = lines[i];
          if (ln.trim().startsWith("```")) {
            flushPara(); flushList();
            if (code === null) { code = []; } else { flushCode(); }
            continue;
          }
          if (code !== null) { code.push(ln); continue; }
          var t = ln.trim();
          if (t === "") { flushPara(); flushList(); continue; }
          var ulm = t.match(/^[-*]\s+(.*)$/);
          var olm = t.match(/^\d+\.\s+(.*)$/);
          if (ulm || olm) {
            flushPara();
            if (!list || list.tag !== (ulm ? "ul" : "ol")) { flushList(); list = { tag: ulm ? "ul" : "ol", items: [] }; }
            list.items.push(ulm ? ulm[1] : olm[1]);
            continue;
          }
          flushList();
          para.push(ln);
        }
        flushPara(); flushList(); flushCode();
        return html;
      }
      function slugify(s) {
        return s.toLowerCase().replace(/[^a-z0-9\s-]/g, "").trim().replace(/\s+/g, "-").replace(/-+/g, "-");
      }
      function renderBody(src) {
        var sections = src.split(/\n##\s+/);
        var html = "";
        sections.forEach(function (sec, idx) {
          if (idx === 0) {
            html += renderBlocks(sec);
            return;
          }
          var nl = sec.indexOf("\n");
          var head = nl === -1 ? sec : sec.slice(0, nl);
          var rest = nl === -1 ? "" : sec.slice(nl + 1);
          html += "<section class=\"study-section\" id=\"" + slugify(head) + "\" data-astro-cid=\"s\">" +
            "<h2 data-astro-cid=\"s\">" + inline(head) + "</h2>" + renderBlocks(rest) + "</section>";
        });
        return html;
      }

      /* ── preview ── */
      function renderPreview() {
        var title = document.getElementById("f-title").value || "Untitled";
        var date = document.getElementById("f-date").value;
        var abs = document.getElementById("f-abstract").value;
        var kw = document.getElementById("f-kw").value;
        var body = document.getElementById("f-body").value;
        var d = date ? new Date(date + "T00:00:00").toLocaleDateString("en-US", { month: "long", year: "numeric" }) : "";
        var kws = kw.split(",").map(function (k) { return k.trim(); }).filter(Boolean);
        var el = document.getElementById("preview");
        el.innerHTML =
          "<div class=\"study-article\" data-astro-cid=\"s\">" +
          "<header class=\"study-header\" data-astro-cid=\"s\">" +
          (d ? "<p class=\"study-date\" data-astro-cid=\"s\">" + d + "</p>" : "") +
          "<h1 class=\"study-title\" data-astro-cid=\"s\">" + esc(title) + "</h1>" +
          (abs ? "<p class=\"study-abstract\" data-astro-cid=\"s\">" + esc(abs) + "</p>" : "") +
          (kws.length ? "<div class=\"study-keywords\" data-astro-cid=\"s\">" + kws.map(function (k) { return "<span class=\"study-kw\" data-astro-cid=\"s\">" + esc(k) + "</span>"; }).join("") + "</div>" : "") +
          "</header>" + renderBody(body) + "</div>";
      }

      /* ── build the .astro page source ── */
      function buildPageSource(slug, title, date, abstract, kws, body, tag) {
        var bodyHtml = renderBody(body);
        var kwArr = kws.map(function (k) { return JSON.stringify(k); }).join(", ");
        var jsonLd = {
          "@context": "https://schema.org", "@type": "BlogPosting",
          "@id": SITE_URL + "/studies/" + slug,
          "headline": title, "datePublished": new Date(date + "T00:00:00").toISOString(),
          "abstract": abstract, "keywords": kws.join(", "),
          "author": { "@type": "Person", "name": "Justin Chua", "url": SITE_URL,
            "sameAs": ["https://linkedin.com/in/justincxa", "https://github.com/juscxnn"] }
        };
        var css = ".study-article[data-astro-cid=\"s\"] { max-width: 680px; margin: 0 auto; padding-block: 32px 48px; }";
        return [
          "---",
          "import { studies } from \"../../data/studies\";",
          "import StudyLayout from \"../../layouts/StudyLayout.astro\";",
          "const slug = " + JSON.stringify(slug) + ";",
          "const study = studies.find(s => s.slug === slug);",
          "const related = studies.filter(s => s.slug !== slug).slice(0, 3);",
          "const dateStr = new Date(study.date).toLocaleDateString(\"en-US\", { month: \"long\", year: \"numeric\" });",
          "const jsonLd = " + JSON.stringify(jsonLd) + ";",
          "---",
          "",
          "<StudyLayout title={study.title} description={study.abstract} jsonLd={jsonLd}>",
          "  <article class=\"study-article\" data-astro-cid=\"s\">",
          "    <header class=\"study-header\" data-astro-cid=\"s\">",
          "      <p class=\"study-date\" data-astro-cid=\"s\">{dateStr}</p>",
          "      <h1 class=\"study-title\" data-astro-cid=\"s\">{study.title}</h1>",
          "      <p class=\"study-abstract\" data-astro-cid=\"s\">{study.abstract}</p>",
          "      <div class=\"study-keywords\" data-astro-cid=\"s\">",
          "        {study.keywords.map(kw => <span class=\"study-kw\" data-astro-cid=\"s\">{kw}</span>)}",
          "      </div>",
          "    </header>",
          "",
          "    " + bodyHtml,
          "",
          "    <aside class=\"study-backlink\" data-astro-cid=\"s\">",
          "      <p class=\"study-backlink-label\" data-astro-cid=\"s\">Personal writing. Notes, musings, and half-finished thoughts.</p>",
          "    </aside>",
          "  </article>",
          "",
          "  <section id=\"related\" data-astro-cid=\"s\">",
          "    <h2 data-astro-cid=\"s\">Related Studies</h2>",
          "    <div class=\"study-related-grid\" data-astro-cid=\"s\">",
          "      {related.map(r => {",
          "        const rd = new Date(r.date).toLocaleDateString(\"en-US\", { month: \"long\", year: \"numeric\" });",
          "        return (",
          "          <a class=\"study-related-card\" href={\`/studies/${r.slug}\`} data-astro-cid=\"s\">",
          "            <p class=\"study-related-date\" data-astro-cid=\"s\">{rd}</p>",
          "            <h3 class=\"study-related-title\" data-astro-cid=\"s\">{r.title}</h3>",
          "            <p class=\"study-related-abstract\" data-astro-cid=\"s\">{r.abstract}</p>",
          "            <span class=\"study-related-link\" data-astro-cid=\"s\">Read &rarr;</span>",
          "          </a>",
          "        );",
          "      })}",
          "    </div>",
          "  </section>",
          "</StudyLayout>",
          "",
          "<style>",
          "  .study-article[data-astro-cid=\"s\"] { max-width: 680px; margin: 0 auto; padding-block: 32px 48px; }",
          "  .study-header[data-astro-cid=\"s\"] { margin-bottom: 40px; }",
          "  .study-date[data-astro-cid=\"s\"] { font-family: var(--mono); font-size: 11px; text-transform: uppercase; letter-spacing: 0.1em; color: var(--muted); margin: 0 0 12px; }",
          "  .study-title[data-astro-cid=\"s\"] { font-family: var(--sans); font-size: clamp(1.6rem, 3vw, 2.2rem); font-weight: 600; line-height: 1.15; letter-spacing: -0.02em; color: var(--ink); margin: 0 0 16px; }",
          "  .study-abstract[data-astro-cid=\"s\"] { font-family: var(--sans); font-size: 16px; line-height: 1.65; color: var(--muted); max-width: 58ch; margin: 0 0 14px; }",
          "  .study-keywords[data-astro-cid=\"s\"] { display: flex; flex-wrap: wrap; gap: 6px; }",
          "  .study-kw[data-astro-cid=\"s\"] { font-family: var(--mono); font-size: 10.5px; letter-spacing: 0.03em; color: var(--ink); background: var(--chip-bg); border: 1px solid var(--hairline-soft); border-radius: 5px; padding: 2px 8px; }",
          "  .study-section[data-astro-cid=\"s\"] { margin-top: 36px; }",
          "  .study-section[data-astro-cid=\"s\"] h2[data-astro-cid=\"s\"] { font-family: var(--sans); font-size: 1.2rem; font-weight: 600; letter-spacing: -0.01em; color: var(--ink); margin: 0 0 14px; }",
          "  .study-section[data-astro-cid=\"s\"] p[data-astro-cid=\"s\"] { font-family: var(--sans); font-size: 15px; line-height: 1.7; color: var(--ink); margin: 0 0 16px; }",
          "  .study-section[data-astro-cid=\"s\"] p[data-astro-cid=\"s\"] strong[data-astro-cid=\"s\"] { font-weight: 500; }",
          "  .study-section[data-astro-cid=\"s\"] em[data-astro-cid=\"s\"] { font-style: italic; }",
          "  .study-section[data-astro-cid=\"s\"] ul[data-astro-cid=\"s\"], .study-section[data-astro-cid=\"s\"] ol[data-astro-cid=\"s\"] { font-family: var(--sans); font-size: 15px; line-height: 1.7; color: var(--ink); margin: 0 0 16px; padding-left: 1.4rem; }",
          "  .study-section[data-astro-cid=\"s\"] li[data-astro-cid=\"s\"] { margin-bottom: 10px; }",
          "  .study-section[data-astro-cid=\"s\"] pre[data-astro-cid=\"s\"] { background: var(--surface); border: 1px solid var(--hairline); border-radius: 8px; padding: 18px 20px; overflow-x: auto; font-size: 12.5px; line-height: 1.6; margin: 18px 0 22px; }",
          "  .study-section[data-astro-cid=\"s\"] pre[data-astro-cid=\"s\"] code[data-astro-cid=\"s\"] { background: none; padding: 0; border-radius: 0; font-size: 12.5px; color: var(--ink); }",
          "  .study-backlink[data-astro-cid=\"s\"] { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 10px; background: var(--surface); border: 1px solid var(--hairline); border-radius: var(--radius); padding: 20px 22px; margin-top: 40px; }",
          "  .study-backlink-label[data-astro-cid=\"s\"] { font-family: var(--sans); font-size: 14px; color: var(--ink); margin: 0; }",
          "  #related[data-astro-cid=\"s\"] { margin-top: 44px; }",
          "  .study-related-grid[data-astro-cid=\"s\"] { display: grid; gap: 10px; grid-template-columns: 1fr; }",
          "  .study-related-card[data-astro-cid=\"s\"] { display: flex; flex-direction: column; background: var(--surface); border: 1px solid var(--hairline); border-radius: var(--radius); padding: 18px; transition: border-color 0.15s, transform 0.15s; }",
          "  .study-related-card[data-astro-cid=\"s\"]:hover { border-color: var(--ink); transform: translateY(-1px); }",
          "  .study-related-date[data-astro-cid=\"s\"] { font-family: var(--mono); font-size: 10.5px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); margin: 0 0 8px; }",
          "  .study-related-title[data-astro-cid=\"s\"] { font-family: var(--sans); font-size: 1.02rem; font-weight: 600; line-height: 1.3; color: var(--ink); margin: 0 0 8px; }",
          "  .study-related-abstract[data-astro-cid=\"s\"] { font-family: var(--sans); font-size: 13.5px; line-height: 1.55; color: var(--muted); margin: 0 0 12px; }",
          "  .study-related-link[data-astro-cid=\"s\"] { font-family: var(--mono); font-size: 11.5px; color: var(--ink); margin-top: auto; }",
          "  @media (max-width: 639px) {",
          "    .study-article[data-astro-cid=\"s\"] { padding-block: 24px 36px; padding-inline: 8px; }",
          "    .study-backlink[data-astro-cid=\"s\"] { flex-direction: column; }",
          "  }",
          "</style>",
        ].join("\n");
      }

      /* ── github commit (trees API, single atomic commit) ── */
      function gh(path, method, token, body) {
        return fetch("https://api.github.com" + path, {
          method: method,
          headers: {
            "Authorization": "Bearer " + token,
            "Accept": "application/vnd.github+json",
            "X-GitHub-Api-Version": "2022-11-28",
          },
          body: body ? JSON.stringify(body) : undefined,
        }).then(function (r) {
          return r.json().then(function (j) {
            if (!r.ok) { var e = new Error(j.message || r.statusText); e.detail = j; throw e; }
            return j;
          });
        });
      }
      function b64(s) {
        return btoa(unescape(encodeURIComponent(s)));
      }
      function buildStudiesEntry(slug, title, date, abstract, kws, tag) {
        return `  {
    slug: ${JSON.stringify(slug)},
    title: ${JSON.stringify(title)},
    date: ${JSON.stringify(date)},
    abstract:
      ${JSON.stringify(abstract)},
    keywords: [
      ${kws.map(function (k) { return JSON.stringify(k); }).join(",\n      ")}
    ],
    backlink: "",
    backlinkLabel: ${JSON.stringify(tag || "writing")},
  },`;
      }
      function publish() {
        var title = document.getElementById("f-title").value.trim();
        var slug = document.getElementById("f-slug").value.trim() || autoSlug();
        var date = document.getElementById("f-date").value;
        var abstract = document.getElementById("f-abstract").value.trim();
        var kwRaw = document.getElementById("f-kw").value;
        var tag = document.getElementById("f-tag").value.trim() || "writing";
        var body = document.getElementById("f-body").value;
        var token = document.getElementById("f-token").value.trim();
        var err = document.getElementById("pub-err");
        err.hidden = true;
        if (!title || !date || !abstract || !body) { showErr("title, date, abstract and body are required."); return; }
        if (!slug) { autoSlug(); slug = document.getElementById("f-slug").value; }
        if (!token) { showErr("paste a GitHub token first."); return; }
        var kws = kwRaw.split(",").map(function (k) { return k.trim(); }).filter(Boolean);
        if (!kws.length) kws = ["notes", "writing"];
        var status = document.getElementById("pub-status");
        var btn = document.getElementById("publish-btn");
        btn.disabled = true;
        status.textContent = "committing…";

        var pageSource = buildPageSource(slug, title, date, abstract, kws, body, tag);
        var entry = buildStudiesEntry(slug, title, date, abstract, kws, tag);

        Promise.resolve()
          .then(function () {
            return gh("/repos/" + REPO_OWNER + "/" + REPO_NAME + "/contents/src/data/studies.ts", "GET", token);
          })
          .then(function (current) {
            var updated = atob(current.content).replace(/\n\];\s*$/, "\n" + entry + "\n];");
            return Promise.all([
              gh("/repos/" + REPO_OWNER + "/" + REPO_NAME + "/git/blobs", "POST", token, { content: b64(pageSource), encoding: "base64" }),
              gh("/repos/" + REPO_OWNER + "/" + REPO_NAME + "/git/blobs", "POST", token, { content: b64(updated), encoding: "base64" }),
            ]);
          })
          .then(function (blobs) {
            return gh("/repos/" + REPO_OWNER + "/" + REPO_NAME + "/git/refs/heads/" + REPO_BRANCH, "GET", token)
              .then(function (ref) {
                return gh("/repos/" + REPO_OWNER + "/" + REPO_NAME + "/git/commits/" + ref.object.sha, "GET", token)
                  .then(function (commit) {
                    return gh("/repos/" + REPO_OWNER + "/" + REPO_NAME + "/git/trees", "POST", token, {
                      base_tree: commit.tree.sha,
                      tree: [
                        { path: "src/pages/studies/" + slug + ".astro", mode: "100644", type: "blob", sha: blobs[0].sha },
                        { path: "src/data/studies.ts", mode: "100644", type: "blob", sha: blobs[1].sha },
                      ],
                    });
                  })
                  .then(function (tree) {
                    return gh("/repos/" + REPO_OWNER + "/" + REPO_NAME + "/git/commits", "POST", token, {
                      message: "Add writing: " + title,
                      tree: tree.sha,
                      parents: [ref.object.sha],
                    });
                  })
                  .then(function (commit) {
                    return gh("/repos/" + REPO_OWNER + "/" + REPO_NAME + "/git/refs/heads/" + REPO_BRANCH, "PATCH", token, { sha: commit.sha, force: false });
                  });
              });
          })
          .then(function () {
            status.textContent = "pushed. deploying…";
            localStorage.removeItem("writer_draft");
            btn.disabled = false;
            status.innerHTML = "live in ~2 min → <a href='" + SITE_URL + "/studies/" + slug + "/' rel='noopener' target='_blank'>view</a>";
          })
          .catch(function (e) {
            btn.disabled = false;
            showErr(e.message + (e.detail && e.detail.documentation_url ? " — see " + e.detail.documentation_url : ""));
          });
      }
      function showErr(m) {
        var e = document.getElementById("pub-err");
        e.textContent = m;
        e.hidden = false;
      }
    </script>

