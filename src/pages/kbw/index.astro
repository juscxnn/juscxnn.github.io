---
import "../../styles/global.css";
import { kbw, buildLots } from "../../data/kbw";

const lots = buildLots();
const committed = lots.filter((l) => l.status !== "available").reduce((s, l) => s + l.price, 0);
const claimed = lots.filter((l) => l.status !== "available").length;
const totalPotential = lots.reduce((s, l) => s + l.price, 0);
const sponsors = lots.filter((l) => l.status !== "available" && l.brand);
const pct = Math.min(100, Math.round((committed / totalPotential) * 100));

// first sold lot with a logo per girl+side, for the on-dress preview
const slotSponsor: Record<string, (typeof lots)[number]> = {};
for (const l of lots) {
  const k = `${l.girl}-${l.side}`;
  if (l.status !== "available" && l.logo && !slotSponsor[k]) slotSponsor[k] = l;
}

const faviconSvg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32"><g fill="#000">${[0, 60, 120, 180, 240, 300]
  .map((a) => `<ellipse cx="16" cy="8.5" rx="4" ry="7.5" transform="rotate(${a} 16 16)"/>`)
  .join("")}</g></svg>`;
const favicon = `data:image/svg+xml,${encodeURIComponent(faviconSvg)}`;
const description = `Ad space on 3 dresses worn ${kbw.worn} at ${kbw.event}, ${kbw.location}. Front $7,500 · back $5,000. All-or-nothing.`;
const tg = `https://t.me/${kbw.telegram}`;
const dressImg = { front: "/kbw/front3.jpg", back: "/kbw/back3.jpg" };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>KBW Seoul — ad space on 3 dresses</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL("/kbw/", Astro.site)} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#FFFFFF" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#111111" />
    <meta property="og:title" content="KBW Seoul — ad space on 3 dresses" />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL("/kbw/", Astro.site)} />
    <meta property="og:image" content={new URL("/kbw/og.png", Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Ad space on 3 dresses at Korea Blockchain Week" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="KBW Seoul — ad space on 3 dresses" />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL("/kbw/og.png", Astro.site)} />
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <script>
      (function () {
        var t = localStorage.getItem("theme");
        if (!t) t = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        document.documentElement.setAttribute("data-theme", t);
        window.toggleTheme = function () {
          var c = document.documentElement.getAttribute("data-theme");
          var n = c === "dark" ? "light" : "dark";
          document.documentElement.setAttribute("data-theme", n);
          localStorage.setItem("theme", n);
        };
      })();
    </script>
  </head>
  <body>
    <header class="nav">
      <div class="wrap nav-inner">
        <a class="wordmark" href="/">Justin Chua</a>
        <div class="nav-right">
          <a class="nav-btn" href="#pick">pick a spot</a>
          <a class="nav-btn" href="#how">how it works</a>
          <button class="nav-btn" onclick="toggleTheme()" aria-label="Toggle color scheme">theme</button>
        </div>
      </div>
    </header>

    <main class="wrap">
      <section class="hero" aria-label="Overview">
        <p class="eyebrow">KBW SEOUL · WORN SEP 30 – OCT 2, 2026</p>
        <h1>Ad space on 3 dresses at Korea Blockchain Week.</h1>
        <p class="lede">
          A booth at KBW costs five figures. A logo on one of our dresses costs a fraction of that
          and is seen by the same 13,000+ attendees — three days across the main conference, side
          events, and dinners.
        </p>

        <div class="bar-wrap">
          <div class="bar"><div class="bar-fill" style={`width: ${pct}%`}></div></div>
          <p class="bar-label">
            <strong>${committed.toLocaleString("en-US")}</strong> of
            ${totalPotential.toLocaleString("en-US")} claimed · {claimed} of {lots.length} lots ·{" "}
            <span id="countdown" data-deadline={kbw.claimDeadline}>—</span>
          </p>
        </div>

        <p class="notice">
          <strong>All or nothing.</strong> The campaign runs only if it is confirmed by the
          deadline. If it isn't, every payment is refunded in full minus network fees. If it is,
          the dresses fly to Seoul.
        </p>

        <div class="hero-ctas">
          <a class="big-cta" href="#pick">pick your spot →</a>
          <a href="#dresses">see the dresses</a>
        </div>
      </section>

      <section class="section" id="pick" aria-label="Pick your spots">
        <h2 class="sec-title">pick your spots</h2>
        <p class="sec-note">
          Front ${kbw.prices.front.toLocaleString("en-US")} · back
          ${kbw.prices.back.toLocaleString("en-US")} per girl, per day. Choose one spot, both
          sides, all three days, or the whole set.
        </p>

        <div class="picker">
          <div class="pick-row">
            <span class="pick-label">girl</span>
            <div class="pick-opts" data-group="girl">
              <button class="opt" data-val="A">Girl A</button>
              <button class="opt" data-val="B">Girl B</button>
              <button class="opt" data-val="C">Girl C</button>
              <button class="opt" data-val="all">All 3</button>
            </div>
          </div>
          <div class="pick-row">
            <span class="pick-label">day</span>
            <div class="pick-opts" data-group="day">
              <button class="opt" data-val="d1">Sep 30</button>
              <button class="opt" data-val="d2">Oct 1</button>
              <button class="opt" data-val="d3">Oct 2</button>
              <button class="opt" data-val="all">All 3 days</button>
            </div>
          </div>
          <div class="pick-row">
            <span class="pick-label">side</span>
            <div class="pick-opts" data-group="side">
              <button class="opt" data-val="front">Front · ${kbw.prices.front.toLocaleString("en-US")}</button>
              <button class="opt" data-val="back">Back · ${kbw.prices.back.toLocaleString("en-US")}</button>
              <button class="opt" data-val="both">Both sides</button>
            </div>
          </div>
        </div>

        <div class="summary">
          <div class="summary-head">
            <p class="summary-count">
              <strong id="sum-count">—</strong> <span id="sum-word">spots</span> selected
            </p>
            <p class="summary-total" id="sum-price">—</p>
          </div>
          <ul class="summary-list" id="sum-list"></ul>
          <button class="big-cta" id="pick-claim" type="button">claim →</button>
          <p class="dim summary-note">
            Taken spots are listed but not charged. Want one anyway? Take it over at 2× — DM
            <a href={tg} rel="noopener">@{kbw.telegram}</a>. Bundle pricing for 6+ spots on request.
            Status updates are manual, so a recent claim may not show yet.
          </p>
        </div>
      </section>

      <section class="section breakout" id="dresses" aria-label="The dresses">
        <h2 class="sec-title">the dresses</h2>
        <p class="sec-note">
          Click a white placement to jump to that girl's spots. Sold placements show the sponsor's
          logo.
        </p>
        <div class="dress-grid">
          {(["front", "back"] as const).map((side) => (
            <figure class="dress">
              <div class="dress-img">
                <img src={dressImg[side]} alt={`Four dresses, ${side} view, with ad placements`} />
                {(["A", "B", "C"] as const).map((g) => {
                  const h = kbw.hotspots[side][g];
                  const sponsor = slotSponsor[`${g}-${side}`];
                  return (
                    <button
                      class="hotspot"
                      data-girl={g}
                      data-side={side}
                      style={`left:${h.x}%;top:${h.y}%;width:${h.w}%;height:${h.h}%`}
                      aria-label={`${g} · ${side} — pick this spot`}
                    >
                      {sponsor?.logo && <img class="hotspot-logo" src={sponsor.logo} alt={sponsor.brand || ""} />}
                      <span class="hotspot-label">
                        {g} · {side} · ${kbw.prices[side].toLocaleString("en-US")}
                      </span>
                    </button>
                  );
                })}
              </div>
              <figcaption>{side}</figcaption>
            </figure>
          ))}
        </div>
      </section>

      {sponsors.length > 0 && (
        <section class="section" id="sponsors" aria-label="Sponsors">
          <h2 class="sec-title">sponsors</h2>
          <p class="sec-note">Already on the dresses:</p>
          <div class="sponsor-grid">
            {sponsors.map((sp) => (
              <a
                class="sponsor"
                href={sp.url || "#"}
                rel="noopener"
                {...(sp.url ? { target: "_blank" } : {})}
              >
                {sp.logo && <img src={sp.logo} alt={sp.brand || ""} />}
                <span class="sponsor-brand">{sp.brand}</span>
                <span class="sponsor-spot">
                  {sp.girlName} · {sp.dayLabel} · {sp.side}
                </span>
              </a>
            ))}
          </div>
        </section>
      )}

      <section class="section" id="how" aria-label="How it works">
        <h2 class="sec-title">how it works</h2>
        <ol class="steps">
          <li><strong>Pick a spot</strong> — girl, day, front or back. Prices are fixed.</li>
          <li>
            <strong>Send USDC on Solana</strong> to the address below for the exact amount. Keep the
            transaction hash.
          </li>
          <li>
            <strong>Send us your details on Telegram</strong> — <a href={tg} rel="noopener"
              >@{kbw.telegram}</a
            >: brand name, website, logo, the wallet you sent from, and the tx hash. The claim form
            below builds the message for you.
          </li>
          <li>
            <strong>We confirm your payment by hand</strong> — your spot flips to taken and your
            logo goes live, usually within a few hours.
          </li>
        </ol>
        <div class="wallet">
          <span class="wallet-label">USDC on Solana (SPL)</span>
          <code>{kbw.wallet}</code>
          <button class="copy-btn" onclick="copyWallet(this)">copy</button>
        </div>
        <p class="sec-note dim">
          Only send USDC on Solana. Assets sent on other chains or other tokens cannot be recovered.
        </p>
      </section>

      <section class="section" id="deliverables" aria-label="What you get">
        <h2 class="sec-title">what you get</h2>
        <ul class="deliverables">
          <li>Your logo printed on the dress and worn for three days — main conference, side events, and dinners.</li>
          <li>Your logo, link, and tagline listed on this page.</li>
          <li>I'll also be dancing like crazy at the parties, for even more attention.</li>
          <li>A thank-you post after the event.</li>
        </ul>
      </section>

      <section class="section" id="girls" aria-label="The three">
        <h2 class="sec-title">the three</h2>
        <p class="sec-note">Revealed once the campaign is confirmed.</p>
        <div class="girl-grid">
          {kbw.girls.map((g) => (
            <div class="girl-card">
              <div class="girl-ph">?</div>
              <p class="girl-card-name">{g.name}</p>
              <p class="dim">to be announced</p>
            </div>
          ))}
        </div>
      </section>

      <section class="section" id="faq" aria-label="FAQ">
        <h2 class="sec-title">faq</h2>
        <dl class="faq">
          <dt>What if the bar isn't reached?</dt>
          <dd>Everyone is refunded in full minus network fees within 7 days. No one pays for a campaign that doesn't run.</dd>
          <dt>How do I claim?</dt>
          <dd>
            Send USDC on Solana, then send your brand, logo, website, sending wallet, and tx hash to{" "}
            <a href={tg} rel="noopener">@{kbw.telegram}</a>. The claim form builds the message for
            you.
          </dd>
          <dt>How long until my spot shows as taken?</dt>
          <dd>
            We confirm payments manually, usually within a few hours. Your logo goes up at the same
            time. If it's been longer, DM <a href={tg} rel="noopener">@{kbw.telegram}</a>.
          </dd>
          <dt>How does a takeover work?</dt>
          <dd>
            A taken spot can be claimed by someone else for 2× the last price. DM{" "}
            <a href={tg} rel="noopener">@{kbw.telegram}</a> and the previous sponsor is refunded in
            full minus network fees within 7 days.
          </dd>
          <dt>What format should my logo be?</dt>
          <dd>SVG or PNG at 1,000px+ wide, transparent background. Send the file on Telegram or link to it.</dd>
          <dt>Can I pay by card?</dt>
          <dd>USDC on Solana only for now. DM <a href={tg} rel="noopener">@{kbw.telegram}</a> if you need an alternative.</dd>
          <dt>What if the event is cancelled?</dt>
          <dd>Full refund minus network fees, or equivalent alternative content — your choice.</dd>
          <dt>What can't be on the dress?</dt>
          <dd>Anything illegal, hateful, sexually explicit, scam-related, or infringing. See the content policy.</dd>
        </dl>
      </section>
    </main>

    <footer class="foot">
      <div class="wrap foot-inner">
        <p class="foot-copy">
          © Justin Chua · Taipei · <a href={tg} rel="noopener">@{kbw.telegram}</a> ·
          <a href="/kbw/legal">terms &amp; policies</a>
        </p>
        <p class="colophon"><a href="/">justinxa.com</a></p>
      </div>
    </footer>

    <!-- claim modal -->
    <div id="modal" class="modal" hidden>
      <div class="modal-card">
        <button class="modal-close" onclick="closeModal()" aria-label="Close">✕</button>
        <p class="eyebrow" id="m-kind">CLAIM</p>
        <h3 id="m-title">—</h3>
        <ul class="m-lots" id="m-lots"></ul>
        <p id="m-price" class="modal-price">—</p>

        <div class="m-step">
          <p class="m-step-head"><span class="m-num">1</span> Send <strong id="m-amount">—</strong> in USDC (Solana)</p>
          <div class="wallet">
            <code>{kbw.wallet}</code>
            <button class="copy-btn" onclick="copyWallet(this)">copy</button>
          </div>
        </div>

        <div class="m-step">
          <p class="m-step-head"><span class="m-num">2</span> Your details</p>
          <div class="m-fields">
            <label>Brand name<input id="f-brand" placeholder="Acme" /></label>
            <label>Website<input id="f-url" placeholder="https://acme.com" /></label>
            <label>Logo URL<input id="f-logo" placeholder="https://acme.com/logo.png" /></label>
            <label class="file-label">or pick your logo file (attach it in the chat)<input id="f-logo-file" type="file" accept="image/*" /></label>
            <label>Telegram or email<input id="f-contact" placeholder="@handle" /></label>
            <label>Sending wallet<input id="f-wallet" placeholder="the address you send from" /></label>
            <label>Tx hash<input id="f-tx" placeholder="paste after sending" /></label>
          </div>
        </div>

        <div class="m-step">
          <p class="m-step-head">
            <span class="m-num">3</span> Send it to <a href={tg} rel="noopener">@{kbw.telegram}</a> —
            and attach your logo file if you picked one
          </p>
          <div class="m-actions">
            <button class="copy-btn solid" onclick="copyClaim(this)">copy details</button>
            <a class="copy-btn" href={tg} rel="noopener">open Telegram</a>
            <a class="copy-btn" id="m-mail" href="#">email instead</a>
          </div>
          <p class="m-note">
            Confirmed by hand. Your spot and logo usually go live within a few hours.
          </p>
        </div>

        <div class="m-preview">
          <p class="m-preview-label">on the dress</p>
          <div class="m-preview-frame" id="m-preview-frame">
            <img id="m-preview-base" src="/kbw/front3.jpg" alt="" />
            <img id="m-preview-logo" alt="" hidden />
          </div>
        </div>
      </div>
    </div>

    <script type="application/json" id="hotspot-data" set:html={JSON.stringify(kbw.hotspots)}></script>
    <script type="application/json" id="dress-img" set:html={JSON.stringify(dressImg)}></script>
    <script type="application/json" id="lots-data" set:html={JSON.stringify(lots)}></script>

    <script>
      const TELEGRAM = "yoloking0";
      const EMAIL = "jcxa@proton.me";
      const HOTSPOTS = JSON.parse(document.getElementById("hotspot-data").textContent);
      const DRESS_IMG = JSON.parse(document.getElementById("dress-img").textContent);

      /* countdown */
      const DEADLINE = document.getElementById("countdown")?.dataset.deadline;
      function tick() {
        const el = document.getElementById("countdown");
        if (!el || !DEADLINE) return;
        const ms = Date.parse(DEADLINE) - Date.now();
        if (ms <= 0) { el.textContent = "claims closed"; return; }
        const d = Math.floor(ms / 86400000);
        const h = Math.floor(ms / 3600000) % 24;
        const m = Math.floor(ms / 60000) % 60;
        const s = Math.floor(ms / 1000) % 60;
        el.textContent = `closes in ${d}d ${h}h ${m}m ${s}s`;
      }
      tick();
      setInterval(tick, 1000);

      /* wallet copy */
      window.copyWallet = function (btn) {
        const addr = "5zim3VG98LahnQTUef8kGbXQ3yTMZzoXK6q5gj1Lfuww";
        const done = () => {
          const old = btn.textContent;
          btn.textContent = "copied";
          setTimeout(() => (btn.textContent = old), 1500);
        };
        if (navigator.clipboard?.writeText) {
          navigator.clipboard.writeText(addr).then(done).catch(() => {
            const ta = document.createElement("textarea");
            ta.value = addr; document.body.appendChild(ta); ta.select();
            document.execCommand("copy"); ta.remove(); done();
          });
        }
      };

      /* picker */
      const LOTS = JSON.parse(document.getElementById("lots-data").textContent);
      const state = { girl: "A", day: "d1", side: "front" };
      const money = (n) => "$" + n.toLocaleString("en-US");

      function selection() {
        return LOTS.filter(
          (l) =>
            (state.girl === "all" || l.girl === state.girl) &&
            (state.day === "all" || l.day === state.day) &&
            (state.side === "both" || l.side === state.side)
        );
      }

      function renderPicker() {
        document.querySelectorAll(".pick-opts").forEach((group) => {
          const key = group.dataset.group;
          group.querySelectorAll(".opt").forEach((btn) => {
            btn.classList.toggle("on", btn.dataset.val === state[key]);
          });
        });
        const sel = selection();
        const avail = sel.filter((l) => l.status === "available");
        const total = avail.reduce((s, l) => s + l.price, 0);
        document.getElementById("sum-count").textContent = avail.length;
        document.getElementById("sum-word").textContent = avail.length === 1 ? "spot" : "spots";
        document.getElementById("sum-price").textContent = total ? money(total) : "$0";
        document.getElementById("sum-list").innerHTML = sel
          .map((l) =>
            l.status === "available"
              ? `<li><span>${l.girlName} · ${l.dayLabel} · ${l.side}</span><span>${money(l.price)}</span></li>`
              : `<li class="taken"><span>${l.logo ? `<img class="mini-logo" src="${l.logo}" alt="">` : ""}${l.brand || "taken"} · ${l.dayLabel} · ${l.side}</span><span>taken · <button type="button" class="takeover-mini" data-lot="${l.id}" data-girl="${l.girl}" data-side="${l.side}" data-label="${l.girlName} · ${l.dayLabel} · ${l.side}" data-price="${l.price * 2}">take over ${money(l.price * 2)}</button></span></li>`
          )
          .join("");
        const btn = document.getElementById("pick-claim");
        btn.disabled = avail.length === 0;
        btn.textContent = avail.length
          ? `claim ${avail.length} ${avail.length === 1 ? "spot" : "spots"} · ${money(total)} →`
          : "all selected spots are taken";
      }

      document.querySelectorAll(".pick-opts").forEach((group) => {
        group.querySelectorAll(".opt").forEach((btn) => {
          btn.addEventListener("click", () => {
            state[group.dataset.group] = btn.dataset.val;
            renderPicker();
          });
        });
      });

      /* hotspots set the picker to that girl + side */
      document.querySelectorAll(".hotspot").forEach((h) => {
        h.addEventListener("click", () => {
          state.girl = h.dataset.girl;
          state.side = h.dataset.side;
          renderPicker();
          document.getElementById("pick").scrollIntoView({ behavior: "smooth", block: "start" });
        });
      });

      /* takeover links inside the summary list */
      document.getElementById("sum-list").addEventListener("click", (e) => {
        const b = e.target.closest(".takeover-mini");
        if (!b) return;
        openModal(
          [{ label: b.dataset.label, girl: b.dataset.girl, side: b.dataset.side, price: Number(b.dataset.price) }],
          true
        );
      });

      /* claim button opens the modal with the available selection */
      document.getElementById("pick-claim").addEventListener("click", () => {
        const avail = selection()
          .filter((l) => l.status === "available")
          .map((l) => ({ label: `${l.girlName} · ${l.dayLabel} · ${l.side}`, girl: l.girl, side: l.side, price: l.price }));
        if (avail.length) openModal(avail, false);
      });

      renderPicker();

      /* modal */
      const modal = document.getElementById("modal");
      let current = null;
      const fields = ["f-brand", "f-url", "f-logo", "f-contact", "f-wallet", "f-tx"];

      function updatePreview() {
        const base = document.getElementById("m-preview-base");
        const logo = document.getElementById("m-preview-logo");
        if (!current || !current.items.length) return;
        const first = current.items[0];
        base.src = DRESS_IMG[first.side];
        const box = HOTSPOTS[first.side][first.girl];
        const fileInput = document.getElementById("f-logo-file");
        const picked = fileInput && fileInput.files[0];
        const url = picked ? URL.createObjectURL(picked) : document.getElementById("f-logo").value.trim();
        if (url && box) {
          logo.hidden = false;
          logo.src = url;
          logo.style.left = box.x + "%";
          logo.style.top = box.y + "%";
          logo.style.width = box.w + "%";
          logo.style.height = box.h + "%";
        } else {
          logo.hidden = true;
        }
      }
      fields.forEach((id) => document.getElementById(id).addEventListener("input", updatePreview));
      document.getElementById("f-logo-file").addEventListener("change", updatePreview);

      function claimText() {
        if (!current) return "";
        const v = (id) => document.getElementById(id).value.trim();
        const total = current.items.reduce((s, i) => s + i.price, 0);
        return [
          `${current.takeover ? "KBW TAKEOVER" : "KBW CLAIM"} — ${money(total)}`,
          `Spots:`,
          ...current.items.map((i) => `  - ${i.label} — ${money(i.price)}`),
          `Brand: ${v("f-brand")}`,
          `Website: ${v("f-url")}`,
          `Logo: ${v("f-logo") || "(attached in this chat)"}`,
          `Contact: ${v("f-contact")}`,
          `Sending wallet: ${v("f-wallet")}`,
          `Tx hash: ${v("f-tx")}`,
        ].join("\n");
      }

      window.copyClaim = function (btn) {
        const text = claimText();
        const done = () => {
          const old = btn.textContent;
          btn.textContent = "copied — now paste in Telegram";
          setTimeout(() => (btn.textContent = old), 2500);
        };
        if (navigator.clipboard?.writeText) {
          navigator.clipboard.writeText(text).then(done).catch(() => {});
        } else {
          const ta = document.createElement("textarea");
          ta.value = text; document.body.appendChild(ta); ta.select();
          document.execCommand("copy"); ta.remove(); done();
        }
      };

      function openModal(items, takeover) {
        current = { items, takeover };
        document.getElementById("m-kind").textContent = takeover ? "TAKEOVER" : "CLAIM";
        document.getElementById("m-title").textContent =
          items.length === 1 ? items[0].label : `${items.length} spots`;
        document.getElementById("m-lots").innerHTML = items
          .map((i) => `<li><span>${i.label}</span><span>${money(i.price)}</span></li>`)
          .join("");
        const total = items.reduce((s, i) => s + i.price, 0);
        const amount = money(total);
        document.getElementById("m-price").textContent = amount;
        document.getElementById("m-amount").textContent = amount;
        fields.forEach((id) => (document.getElementById(id).value = ""));
        const subject = encodeURIComponent(
          `${takeover ? "Takeover" : "Claim"}: ${items.map((i) => i.label).join(" + ")} — ${amount}`
        );
        const body = encodeURIComponent(claimText());
        document.getElementById("m-mail").href = `mailto:${EMAIL}?subject=${subject}&body=${body}`;
        updatePreview();
        modal.hidden = false;
        document.getElementById("f-brand").focus();
      }

      window.closeModal = () => {
        modal.hidden = true;
        current = null;
      };
      modal.addEventListener("click", (e) => { if (e.target === modal) closeModal(); });
      document.addEventListener("keydown", (e) => { if (e.key === "Escape") closeModal(); });
    </script>

    <style>
      .hero { padding-block: 2.5rem 1rem; }
      h1 { font-size: clamp(1.7rem, 4.5vw, 2.4rem); max-width: 22ch; }
      .lede { color: var(--muted); max-width: 54ch; }

      .bar-wrap { margin: 1.75rem 0 0.5rem; }
