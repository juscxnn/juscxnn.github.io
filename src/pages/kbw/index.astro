      /* summary */
      .summary { border: 1px solid var(--ink); padding: 16px; }
      .summary-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 6px 14px; margin-bottom: 10px; }
      .summary-count { margin: 0; font-size: 15px; }
      .summary-total { margin: 0; font-family: var(--mono); font-size: 1.5rem; font-weight: 700; }
      .summary-list { list-style: none; margin: 0 0 14px; padding: 0; }
      .summary-list li {
