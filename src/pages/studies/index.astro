---
import { studies } from "../../data/studies";
import StudyLayout from "../../layouts/StudyLayout.astro";

const sorted = [...studies].sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

function formatDate(dateStr: string): string {
  const d = new Date(dateStr);
  return d.toLocaleDateString("en-US", { month: "long", year: "numeric" });
}

function excerpt(text: string, max = 150): string {
  if (text.length <= max) return text;
  return text.slice(0, max).replace(/\s+\S*$/, "") + "\u2026";
}

const description =
  "Technical studies on persona generation, burst dialogue, simulated attention, and coherence evaluation. By Justin Chua.";

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Studies \u2014 Justin Chua",
  description,
  url: new URL("/studies", Astro.site).toString(),
  mainEntity: {
    "@type": "ItemList",
    itemListElement: sorted.map((s, i) => ({
      "@type": "ListItem",
      position: i + 1,
      url: new URL(`/studies/${s.slug}`, Astro.site).toString(),
      name: s.title,
      description: s.abstract,
    })),
  },
});
---

<StudyLayout title="Studies" description={description} jsonLd={jsonLd}>
  <div class="studies-page" data-astro-cid="s">
    <a class="back-link" href="/" data-astro-cid="s">&larr; home</a>

    <header class="studies-header" data-astro-cid="s">
      <h1 class="studies-heading" data-astro-cid="s">Studies</h1>
      <p class="studies-sub" data-astro-cid="s">
        Technical writing on persona generation, community simulation, and the economics of synthetic users.
      </p>
    </header>

    <div class="studies-list" data-astro-cid="s">
      {sorted.map((s) => (
        <article class="study-card" data-astro-cid="s">
          <time class="study-date" datetime={s.date} data-astro-cid="s">{formatDate(s.date)}</time>
          <h2 class="study-title" data-astro-cid="s">
            <a href={`/studies/${s.slug}`} data-astro-cid="s">{s.title}</a>
          </h2>
          <p class="study-excerpt" data-astro-cid="s">{excerpt(s.abstract)}</p>
          <div class="study-tags" data-astro-cid="s">
            {s.keywords.map((kw) => <span class="study-tag" data-astro-cid="s">{kw}</span>)}
          </div>
        </article>
      ))}
    </div>
  </div>
</StudyLayout>

<style>
  .studies-page[data-astro-cid="s"] {
    max-width: 720px;
    margin: 0 auto;
  }

  .back-link[data-astro-cid="s"] {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--muted);
    display: inline-block;
    margin-top: 8px;
    transition: color 0.15s ease;
  }

  .back-link[data-astro-cid="s"]:hover {
    color: var(--ink);
  }

  .studies-header[data-astro-cid="s"] {
    margin: 24px 0 28px;
  }

  .studies-heading[data-astro-cid="s"] {
    font-weight: 600;
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    letter-spacing: -0.025em;
    line-height: 1.15;
    margin: 0 0 8px;
  }

  .studies-sub[data-astro-cid="s"] {
    font-size: 14px;
    line-height: 1.6;
    color: var(--muted);
    margin: 0;
    max-width: 52ch;
  }

  .studies-list[data-astro-cid="s"] {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .study-card[data-astro-cid="s"] {
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    padding: 20px 22px;
    background: var(--surface);
    transition: border-color 0.15s ease, transform 0.15s ease;
  }

  .study-card[data-astro-cid="s"]:hover {
    border-color: var(--green);
    transform: translateY(-1px);
  }

  .study-date[data-astro-cid="s"] {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--muted);
    display: block;
    margin-bottom: 6px;
  }

  .study-title[data-astro-cid="s"] {
    font-weight: 600;
    font-size: 1.1rem;
    letter-spacing: -0.01em;
    line-height: 1.3;
    margin: 0 0 10px;
  }

  .study-title[data-astro-cid="s"] a[data-astro-cid="s"] {
    transition: color 0.15s ease;
  }

  .study-title[data-astro-cid="s"] a[data-astro-cid="s"]:hover {
    color: var(--green);
  }

  .study-excerpt[data-astro-cid="s"] {
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--muted);
    margin: 0 0 14px;
  }

  .study-tags[data-astro-cid="s"] {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .study-tag[data-astro-cid="s"] {
    font-family: var(--mono);
    font-size: 10.5px;
    color: var(--muted);
    background: var(--tint);
    border-radius: 999px;
    padding: 3px 10px;
  }

  @media (max-width: 639px) {
    .study-card[data-astro-cid="s"] {
      padding: 18px;
    }

    .study-title[data-astro-cid="s"] {
      font-size: 1rem;
    }
  }
</style>
